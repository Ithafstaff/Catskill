{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "format": "oxfmt",
    "test:daf-yomi": "node --experimental-strip-types --test tests/dafYomi.test.mjs",
    "check:supabase": "node --env-file=.env.local scripts/check-supabase.mjs",
    "test:backend": "node --test tests/moderation.test.mjs",
    "test:maps": "node --experimental-strip-types --test tests/coordinates.test.mjs tests/mapPlaces.test.mjs",
    "test:calendar": "node --experimental-strip-types --test tests/communityDate.test.mjs",
    "test:auth": "node --experimental-strip-types --test tests/authProfile.test.mjs tests/authEmail.test.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:security": "node --experimental-strip-types --test tests/security.test.mjs tests/securityDatabase.test.mjs tests/notificationWorker.test.mjs",
    "scan:secrets": "node scripts/security-scan.mjs --history"
  },
  "dependencies": {
    "@hebcal/core": "^6.14.7",
    "@supabase/supabase-js": "^2.118.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.1.6"
  },
  "pnpm": {
    "overrides": {
      "source-map-js": "^1.2.2"
    }
  }
}
