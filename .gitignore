# Dependencies and the repository-local pnpm store
node_modules/
/.pnpm-store/

# Vite production output; Vercel builds this from source
/dist/

# Vercel CLI project links and downloaded local deployment configuration
/.vercel/

# Local browser and Supabase Edge Function environment values
# Templates must contain placeholders only; review before committing.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Private keys and key containers; public PEM certificates remain trackable.
*.key
*.p12
*.pfx
*-key.pem
*_key.pem
*.key.pem
privkey.pem
private.pem

# Supabase CLI metadata and local branch state
# Keep config.toml, migrations, and function source trackable.
/supabase/.temp/
/supabase/.branches/

# Impeccable runtime state; keep the shared .impeccable/config.json.
/.impeccable/hook.cache.json
/.impeccable/hook.pending.json
/.impeccable/config.local.json

# npm/pnpm diagnostic output; do not hide arbitrary application log fixtures
npm-debug.log*
pnpm-debug.log*
.pnpm-debug.log*

# Local editor swap/backup files; shared editor configuration stays trackable.
*.swp
*.swo
*~

# macOS Finder metadata and AppleDouble resource-fork sidecars
.DS_Store
._*
